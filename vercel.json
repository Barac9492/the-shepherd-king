{
  "functions": {
    "api/sling-challenge/*.js": {
      "maxDuration": 20
    },
    "api/dance-challenge/*.js": {
      "maxDuration": 20
    },
    "api/engedi-challenge/*.js": {
      "maxDuration": 20
    },
    "api/keilah.js": {
      "maxDuration": 20
    },
    "api/downfall-challenge/*.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/keilah/:path*",
      "destination": "/api/keilah?route=:path*"
    }
  ]
}
